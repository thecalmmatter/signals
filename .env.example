# Copy to .env.local and fill in every value. .env.local is gitignored and
# must never be committed.

# Neon Postgres connection string. IMPORTANT: use the POOLED connection
# string (hostname contains "-pooler"), not the direct one — copy it from
# Neon Console -> Connect -> toggle "Connection pooling" on. On serverless
# hosting (Vercel), each function instance can open its own connection pool;
# pointed at the direct host this exhausts Neon's max_connections quickly
# under real concurrent traffic. The pooled endpoint fans out via PgBouncer
# instead and is safe for this app's usage (no SET/LISTEN/NOTIFY/temp-table
# session state anywhere in the codebase).
DATABASE_URL=

# Clerk API keys (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Chartlink webhook token — generate with: openssl rand -hex 24
CHARTLINK_WEBHOOK_TOKEN=

# Your Clerk user id(s), comma-separated. Grants /dashboard/admin + admin APIs.
ADMIN_USER_IDS=

# Fyers app credentials — used server-side by /api/stocks/[symbol] to power
# the signal detail splash (candle chart + RSI). Separate from any Fyers MCP
# login used in a Claude session; this is the app's own API access.
# FYERS_APP_ID looks like "XXXXXXXXX-100"; FYERS_ACCESS_TOKEN expires daily
# and needs to be refreshed (Fyers OAuth) on a schedule outside this app.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# Indian API (https://indianapi.in) — powers /dashboard/stocks/[symbol], the
# per-stock analytics pane: analyst consensus (buy/hold/sell), shareholding,
# corporate actions, and recent news. None of this comes from Fyers (that's
# price/candles/orders only) or from any MCP connector available at request
# time — this is a plain REST API the app calls directly with its own key.
# Get a key at indianapi.in, then:
#   curl -H "X-API-Key: YOUR_KEY" https://analyst.indianapi.in/stock?symbol=TCS
# Leave blank to disable — the analytics pane just shows "not configured"
# for the affected tiles instead of breaking the page.
INDIAN_STOCK_API_KEY=

# "Ask about this setup" chat (signal detail splash, /api/stocks/[symbol]/chat).
# LLM_PROVIDER picks which one is active: anthropic | deepseek | glm | kimi.
# Only the selected provider's key is required at runtime; keep the others
# blank or filled in for quick switching. Model names are overridable — the
# defaults below are a reasonable starting point, not verified against every
# provider's current lineup.
LLM_PROVIDER=anthropic

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# GLM (Zhipu AI) — https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# Kimi — self-hosted on Modal, OpenAI-compatible endpoint.
KIMI_API_KEY=
KIMI_MODEL=moonshotai/Kimi-K3

# Razorpay — recurring subscription billing (Razorpay Subscriptions API).
# https://dashboard.razorpay.com/app/keys for Key ID/Secret.
# RAZORPAY_PLAN_ID: create a Plan in Dashboard -> Subscriptions -> Plans first
# (the ₹499/month Pro plan) and paste its plan_xxxxx id here.
# RAZORPAY_WEBHOOK_SECRET: Dashboard -> Settings -> Webhooks -> add
# https://<your-domain>/api/webhooks/razorpay, subscribe to the
# subscription.* events, copy the secret it gives you.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the same Key ID, safe to expose client-side
# (Checkout needs it in the browser) — Key Secret never goes to the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Sitewide billing kill switch. Default (unset, or "true") = paywall/trial
# logic in lib/access.ts runs as normal. Set to "false" to give every
# signed-in user full free access unconditionally — useful for a free public
# dry-run before RIA registration — without touching per-user trial dates or
# the Razorpay flow underneath. Flip back to "true" (or remove) any time.
BILLING_ENABLED=true

# Optional: Telegram push notification when a Chartlink scan arrives that
# isn't in scan_mappings (the "unmapped scan" review queue) — so you don't
# have to keep the admin dashboard open to catch it. Leave both blank to
# disable; the webhook works fine without this.
# Setup: message @BotFather on Telegram -> /newbot -> copy the token it
# gives you into TELEGRAM_BOT_TOKEN. Then send your new bot any message and
# GET https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your production domain, no trailing slash (e.g. https://signals.example.com).
# Used to build the signup link the Telegram leads bot sends back — never
# hardcoded/guessed in code, since a wrong domain baked into a message would
# silently send every lead to a broken link.
SITE_URL=

# Optional: dedicated Telegram bot for the Telegram Ads lead-capture funnel
# (@SignalsLeadsBot or whatever you name it) — separate bot/token from
# TELEGRAM_BOT_TOKEN above, which only ever sends outbound admin alerts and
# has no webhook. This one receives updates, so someone tapping the ad's
# t.me/<bot>?start=<tag> deep link and hitting Start gets logged (see
# scripts/migration_telegram_leads.sql, app/dashboard/admin/users) and gets
# an auto-reply back.
# Setup: @BotFather -> /newbot -> copy the token into TELEGRAM_LEADS_BOT_TOKEN.
# Generate TELEGRAM_LEADS_WEBHOOK_SECRET with: openssl rand -hex 24
# After deploying, register the webhook once:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/api/webhooks/telegram-leads&secret_token=<SECRET>"
TELEGRAM_LEADS_BOT_TOKEN=
TELEGRAM_LEADS_WEBHOOK_SECRET=

# Optional: public "results" channel — the moment a signal's stop or a
# target is hit (see scripts/migration_signal_outcome_lock.sql), the outcome
# gets posted here automatically: symbol, entry -> exit, return %, days in.
# Results only, never the live actionable feed — see README §11. Reuses the
# same bot as TELEGRAM_LEADS_BOT_TOKEN above (add it as admin to the
# channel). Public channel: use "@yourchannelusername". Private channel: the
# numeric chat id (looks like "-100xxxxxxxxxx", find it via getUpdates after
# posting once in the channel). Leave blank to disable — nothing breaks.
TELEGRAM_RESULTS_CHANNEL_ID=

# Only needed if the channel above is PRIVATE (numeric chat id) and you want
# the leads bot's welcome message to link to it (app/api/webhooks/telegram-leads).
# For a public channel ("@handle"), the join link is derived automatically —
# leave this blank. Get it from Telegram Desktop/app -> channel -> Invite Links.
TELEGRAM_RESULTS_CHANNEL_URL=

# Periodic "symbols + overall return since last post" digest to the same
# results channel above (see scripts/migration_telegram_digest.sql and
# lib/telegram-digest.ts) — separate from the instant per-close post.
# Triggered by the Vercel Cron entry in vercel.json (fires once/day on the
# Hobby plan; see its comment for Pro-plan finer schedules). This env var
# controls the *actual* posting cadence on top of that trigger — e.g. 24 to
# post every time the daily cron fires, 48 to post every other day — and
# takes effect on the next cron tick with no redeploy. Digest only actually
# posts if something has closed since the last one; a quiet stretch is
# silently skipped, not padded with an empty message.
DIGEST_INTERVAL_HOURS=24

# Second, independent periodic post to the same channel — a compact
# symbol/return/days table of every currently-active signal (open, stopped,
# and target-hit alike), not just what closed recently. Posts
# unconditionally on its own schedule (no "nothing to report" case — open
# positions always exist to show). Same no-redeploy behavior as
# DIGEST_INTERVAL_HOURS above.
SNAPSHOT_INTERVAL_HOURS=24

# Set this to any random secret and Vercel will automatically send it back
# as "Authorization: Bearer <value>" on requests it generates for the cron
# job above, which /api/cron/telegram-digest checks. Generate with:
# openssl rand -hex 24. Also works as a manual "?token=<value>" query param
# if you want to trigger a digest check by hand.
CRON_SECRET=
