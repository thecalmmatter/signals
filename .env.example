# Copy to .env.local and fill in every value. .env.local is gitignored and
# must never be committed.

# Neon Postgres connection string.
DATABASE_URL=

# Clerk API keys (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Chartlink webhook token — generate with: openssl rand -hex 24
CHARTLINK_WEBHOOK_TOKEN=

# Your Clerk user id(s), comma-separated. Grants /dashboard/admin + admin APIs.
ADMIN_USER_IDS=

# Fyers app credentials — used server-side by /api/stocks/[symbol] to power
# the signal detail splash (candle chart + RSI). Separate from any Fyers MCP
# login used in a Claude session; this is the app's own API access.
# FYERS_APP_ID looks like "XXXXXXXXX-100"; FYERS_ACCESS_TOKEN expires daily
# and needs to be refreshed (Fyers OAuth) on a schedule outside this app.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# "Ask about this setup" chat (signal detail splash, /api/stocks/[symbol]/chat).
# LLM_PROVIDER picks which one is active: anthropic | deepseek | glm.
# Only the selected provider's key is required at runtime; keep the others
# blank or filled in for quick switching. Model names are overridable — the
# defaults below are a reasonable starting point, not verified against every
# provider's current lineup.
LLM_PROVIDER=anthropic

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# GLM (Zhipu AI) — https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# Razorpay — recurring subscription billing (Razorpay Subscriptions API).
# https://dashboard.razorpay.com/app/keys for Key ID/Secret.
# RAZORPAY_PLAN_ID: create a Plan in Dashboard -> Subscriptions -> Plans first
# (the ₹499/month Pro plan) and paste its plan_xxxxx id here.
# RAZORPAY_WEBHOOK_SECRET: Dashboard -> Settings -> Webhooks -> add
# https://<your-domain>/api/webhooks/razorpay, subscribe to the
# subscription.* events, copy the secret it gives you.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the same Key ID, safe to expose client-side
# (Checkout needs it in the browser) — Key Secret never goes to the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Sitewide billing kill switch. Default (unset, or "true") = paywall/trial
# logic in lib/access.ts runs as normal. Set to "false" to give every
# signed-in user full free access unconditionally — useful for a free public
# dry-run before RIA registration — without touching per-user trial dates or
# the Razorpay flow underneath. Flip back to "true" (or remove) any time.
BILLING_ENABLED=true
